# Apache sample — place in VirtualHost with SSL
<VirtualHost *:443>
  ServerName learn.yourdomain.com
  DocumentRoot /var/www/learnhub
  SSLEngine on
  SSLCertificateFile /etc/letsencrypt/live/learn.yourdomain.com/fullchain.pem
  SSLCertificateKeyFile /etc/letsencrypt/live/learn.yourdomain.com/privkey.pem

  <Directory /var/www/learnhub>
    Require all granted
    FallbackResource /index.html
  </Directory>

  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</VirtualHost>
