rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdminEmail() { return signedIn() && request.auth.token.email == 'shariqq.com@gmail.com'; }
    function isAdmin() { return isAdminEmail() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {}; }
    function notDisabled() { return isAdmin() || (signedIn() && (!('status' in me()) || me().status != 'disabled')); }
    function canComment() { return isAdmin() || (notDisabled() && (!('commenting' in me()) || me().commenting != 'off')); }
    function isEnrolled(courseId) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }
    // Public catalog for SEO: ONLY published course documents are readable
    // without login (title/description/outcomes for snapshots + sitemap).
    // Lessons, quizzes and drafts are never public: the prerender build reads
    // them with the Firebase Admin SDK, and snapshots contain titles/durations
    // only — never video IDs.
    function isPublishedCourse() { return resource.data.status == 'published' || resource.data.published == true; }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Admin-only app config (e.g. GitHub deploy token for on-demand rebuilds).
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    match /courses/{courseId} {
      // published courses readable by anyone (public catalog + SEO); drafts/archived need login+enrollment or admin.
      // NOTE: get/list are split on purpose. List queries MUST constrain
      // where('status','==','published') (as the catalog does) — Firestore
      // rejects unconstrained lists when rules branch on document data.
      // Only non-published docs cost the single admins-collection check.
      // (Disabled-account enforcement lives on writes, comments/reports, and app-side sign-out.)
      allow get: if isPublishedCourse() || isAdmin() || (notDisabled() && isEnrolled(courseId));
      allow list: if isPublishedCourse() || isAdmin();
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        // never public — the player page requires enrollment (same zero-get rule shape)
        allow read: if isAdmin() || isEnrolled(courseId);
        allow write: if isAdmin();
      }
      match /quizzes/{quizId} {
        allow read: if isAdmin() || isEnrolled(courseId);
        allow write: if isAdmin();
      }

      // Course reviews: public read (social proof), enrolled users write own, admins moderate.
      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == uid && isEnrolled(courseId)
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    match /tags/{tagId} {
      // Public catalog metadata (names, counts) — readable by everyone including guests.
      // Only admins can create, update, delete tags.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      match /enrollments/{courseId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /quizAttempts/{attemptId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /bookmarks/{courseId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /paths/{pathId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if notDisabled();
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      // list must stay get()-free (same per-request read cap as courses)
      allow get: if notDisabled();
      allow list: if signedIn();
      allow create: if canComment() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /stats/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin() || signedIn();
    }

    // First-party traffic analytics: anyone may append a view event with a
    // strict shape (abuse-bounded: once per path per session client-side).
    // Only admins can read them back; events are immutable.
    match /pageviews/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['path', 'courseId', 'uid', 'ts'])
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() < 200;
      allow update, delete: if false;
    }
  }
}
