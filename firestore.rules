rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdminEmail() { return signedIn() && request.auth.token.email == 'shariqq.com@gmail.com'; }
    function isAdmin() { return isAdminEmail() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {}; }
    function notDisabled() { return isAdmin() || (signedIn() && (!('status' in me()) || me().status != 'disabled')); }
    function canComment() { return isAdmin() || (notDisabled() && (!('commenting' in me()) || me().commenting != 'off')); }
    function isEnrolled(courseId) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }
    // Public catalog for SEO: published courses (and their syllabi) are readable
    // without login. Videos stay gated by the app (enrollment required for /learn),
    // quizzes stay enrolled-only. Note: lesson reads do one extra get() for the parent.
    function isPublishedCourse() { return resource.data.status == 'published' || resource.data.published == true; }
    function parentPublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        || get(/databases/$(database)/documents/courses/$(courseId)).data.published == true;
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      // published courses readable by anyone (public catalog + SEO); drafts/archived need login+enrollment or admin
      allow read: if isPublishedCourse() || isAdmin() || (notDisabled() && isEnrolled(courseId));
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        // syllabus (titles/durations) is public for published courses; the player page still requires enrollment
        allow read: if parentPublished(courseId) || isAdmin() || (notDisabled() && isEnrolled(courseId));
        allow write: if isAdmin();
      }
      match /quizzes/{quizId} {
        allow read: if isAdmin() || isEnrolled(courseId);
        allow write: if isAdmin();
      }
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      match /enrollments/{courseId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /quizAttempts/{attemptId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /bookmarks/{courseId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /paths/{pathId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if notDisabled();
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if notDisabled();
      allow create: if canComment() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /stats/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin() || signedIn();
    }
  }
}
